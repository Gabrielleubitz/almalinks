{
  "name": "almalinks",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:Gabrielleubitz/almalinks.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --force --port 5173",
    "dev:api": "vercel dev --listen 3000",
    "dev:all": "concurrently --kill-others-on-fail \"npm run dev\" \"npm run dev:api\"",
    "dev:express": "node dev-server.js",
    "dev:vercel": "vercel dev",
    "dev:netlify": "netlify dev --port 8888",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fix-user-claims": "node scripts/fix-user-claims.js",
    "check-activities": "node scripts/check-activities.js",
    "test:mailchimp": "node scripts/test-mailchimp-campaign.js",
    "build:email-logos": "node scripts/email-logos-to-png.js",
    "deploy:backend": "echo 'Backend is now consolidated in api/index.js. All handlers are in lib/server/api/. Use git add/commit/push as needed.'",
    "verify:deployment": "echo 'Check Vercel dashboard: https://vercel.com/your-project/deployments'"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.70.0",
    "@mailchimp/mailchimp_transactional": "^1.1.2",
    "@types/leaflet.markercluster": "^1.5.6",
    "blueimp-md5": "^2.19.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.0.0",
    "concurrently": "^8.2.2",
    "framer-motion": "^11.11.17",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.263.1",
    "nanoid": "^5.1.6",
    "node-mailjet": "^6.0.5",
    "openai": "^5.23.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^6.8.1",
    "sharp": "^0.34.4",
    "tailwind-merge": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "netlify-cli": "^17.38.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.8"
  },
  "overrides": {
    "@daily-co/daily-js": "^0.70.0"
  }
}
