# Copy this file to .env and fill in your values. Do not commit .env.
# For production (e.g. Vercel), set these in the project Environment Variables.

# ---------------------------------------------------------------------------
# Firebase Admin (for local API: npm run dev:express)
# ---------------------------------------------------------------------------
# Required for /api/send-event-announcement and other admin APIs when running locally.
# Paste the full JSON from Firebase Console → Project Settings → Service Accounts → Generate new private key,
# or base64-encode that JSON and set FIREBASE_SERVICE_ACCOUNT_KEY to the base64 string.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ---------------------------------------------------------------------------
# Mailchimp Transactional (Mandrill) — 1-to-1 emails
# ---------------------------------------------------------------------------
# Mandrill API key for ALL transactional emails (signup, approval, event registration, etc.).
# Format: md-xxxxxxxx (from Mailchimp → Transactional / API keys). Domain almalinks.org must be verified in Mandrill.
# Set in Vercel → Project → Settings → Environment Variables (and in .env locally).
MAILCHIMP_API_KEY=your_mandrill_key_here

# Required: "From" address for transactional emails. Must be @almalinks.org (verified in Mandrill Sending Domains).
TRANSACTIONAL_FROM_EMAIL=noreply@almalinks.org

# Optional: Display name and reply-to for transactional emails.
# TRANSACTIONAL_FROM_NAME=Alma Links
# TRANSACTIONAL_REPLY_TO=noreply@almalinks.org

# ---------------------------------------------------------------------------
# Mailchimp Marketing — bulk campaigns / audience only
# ---------------------------------------------------------------------------
# Mailchimp server/datacenter (e.g. us5, us19). Required for Marketing API (audience + campaigns).
MAILCHIMP_SERVER=us5

# Mailchimp audience (list) ID. Required for list sync and "new event → email whole audience" campaigns.
MAILCHIMP_AUDIENCE_ID=d2650d7ca2

# Marketing API key for bulk campaigns and audience sync only. Format: xxxxx-us5.
# Used by: send-event-announcement, mailchimp-import-users, mailchimp-sync-contact. NOT used for 1-to-1 emails.
MAILCHIMP_MARKETING_API_KEY=your_mailchimp_marketing_key_here

# Campaign "from" name and reply-to (required for send-event-announcement only).
# MAILCHIMP_REPLY_TO must be a verified email on your Mailchimp domain.
# MAILCHIMP_FROM_NAME=Alma Links
# MAILCHIMP_REPLY_TO=noreply@almalinks.org

# Optional: custom HTML for the welcome email (sent on first signup). Use {{name}} for display name.
# MAILCHIMP_WELCOME_TEMPLATE_HTML=<h1>Welcome!</h1><p>Hi {{name}}, thanks for joining.</p>

# ---------------------------------------------------------------------------
# Legacy / optional email fallbacks (optional)
# ---------------------------------------------------------------------------
# EMAIL_FROM=Communications@almalinks.org

# ---------------------------------------------------------------------------
# Admin notifications (optional)
# ---------------------------------------------------------------------------
# ADMIN_NOTIFICATION_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# Email flows: base URL for links (production)
# ---------------------------------------------------------------------------
# Base URL for links in emails (login, events, admin pending). Used ONLY to build links; does NOT control recipients.
# In production set this so links point to your domain (e.g. https://almalinks.org). Defaults to VERCEL_URL or https://almalinks.org.
# APP_URL=https://almalinks.org

# Optional: gate POST /api/test-mandrill — require header x-test-secret: <value>. If unset, anyone can call it.
# TEST_MANDRILL_SECRET=your_secret_here
# Optional: default recipient when body.to is omitted for POST /api/test-mandrill.
# TEST_MANDRILL_EMAIL=you@example.com

# Development-only: test recipient overrides. IGNORED when NODE_ENV=production. Do not set in production.
# TEST_EMAIL=test@example.com
# TEST_EMAIL_SIGNUP_USER, TEST_EMAIL_SIGNUP_ADMIN, etc. or SIGNUP_TEST_RECIPIENT (legacy)

# ---------------------------------------------------------------------------
# HubSpot → Firestore sync (POST /api/sync-hubspot-contacts)
# ---------------------------------------------------------------------------
# HubSpot Private App or OAuth access token. Used server-side only; never expose in frontend.
# Required for "Sync HubSpot → Firebase" to import all HubSpot CRM contacts into Firestore (hubspotContacts)
# and create Firebase Auth accounts so contacts can sign in and complete onboarding.
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx

# Optional: default password for HubSpot-imported users (they sign in with email + this password, then complete onboarding).
# If unset, defaults to 123456789. Consider changing in production.
# HUBSPOT_IMPORT_DEFAULT_PASSWORD=123456789

# Optional: require header x-sync-secret: <value> to call /api/sync-hubspot-contacts.
# If set, requests must include header x-sync-secret with this value (alternative to Firebase Auth admin).
# If unset, endpoint requires Firebase Auth ID token and admin role.
# SYNC_SECRET=your_shared_secret_here

# ---------------------------------------------------------------------------
# Cloudinary — profile images (POST /api/upload-profile-image, /api/delete-profile-image)
# ---------------------------------------------------------------------------
# From Cloudinary dashboard: Product Environment Credentials (cloud name, API key, API secret).
# Store API secret in env only; never commit. Required for profile picture upload/delete.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
