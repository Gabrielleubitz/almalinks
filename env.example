# Copy this file to .env and fill in your values. Do not commit .env.
# For production (e.g. Vercel), set these in the project Environment Variables.

# ---------------------------------------------------------------------------
# Mailchimp / Mandrill (transactional email)
# ---------------------------------------------------------------------------
# Mailchimp API key (Mandrill format: key includes server suffix, e.g. xxxxx-us5)
# Used for: send-email, notify-signup, notify-user-signup, send-bulk-email
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Mailchimp server/datacenter (e.g. us5, us6). Optional if key already has suffix.
# Used for Mailchimp Marketing API base URL: https://{server}.api.mailchimp.com/3.0
MAILCHIMP_SERVER=us5

# Mailchimp audience (list) ID for Marketing API (e.g. add contacts, campaigns).
# Used when syncing signups/approved users to a Mailchimp audience.
MAILCHIMP_AUDIENCE_ID=d2650d7ca2

# Legacy name (still supported): use MAILCHIMP_API_KEY in new deployments
# MANDRILL_API_KEY=

# ---------------------------------------------------------------------------
# Email sender (optional)
# ---------------------------------------------------------------------------
# EMAIL_FROM=Communications@almalinks.org

# ---------------------------------------------------------------------------
# Admin notifications (optional)
# ---------------------------------------------------------------------------
# ADMIN_NOTIFICATION_EMAILS=admin@example.com
