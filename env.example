# Copy this file to .env and fill in your values. Do not commit .env.
# For production (e.g. Vercel), set these in the project Environment Variables.

# ---------------------------------------------------------------------------
# Firebase Admin (for local API: npm run dev:express)
# ---------------------------------------------------------------------------
# Required for /api/send-event-announcement and other admin APIs when running locally.
# Paste the full JSON from Firebase Console → Project Settings → Service Accounts → Generate new private key,
# or base64-encode that JSON and set FIREBASE_SERVICE_ACCOUNT_KEY to the base64 string.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ---------------------------------------------------------------------------
# Mailchimp (transactional + audience)
# ---------------------------------------------------------------------------
# Mailchimp Transactional (Mandrill) API key for sending emails.
# Format: md-xxxxxxxx or xxxxx-us5 (from Mailchimp → Transactional / API keys).
# Used for: send-email, notify-signup, notify-user-signup.
# Set this in Vercel → Project → Settings → Environment Variables (and in .env locally).
MAILCHIMP_API_KEY=your_mailchimp_transactional_key_here

# Mailchimp server/datacenter (e.g. us5, us19). Required for Marketing API (audience sync).
# If your Transactional key has a suffix like -us5, we can derive it; otherwise set here.
MAILCHIMP_SERVER=us5

# Mailchimp audience (list) ID. Required for list sync: signup → list, approval → list,
# Import users button, and adding recipients when sending bulk email.
MAILCHIMP_AUDIENCE_ID=d2650d7ca2

# Marketing API key for audience/list sync (Import users, add to list). Format: xxxxx-us5.
# If not set, MAILCHIMP_API_KEY is used for audience sync.
# Set in Vercel → Settings → Environment Variables (and in .env locally).
MAILCHIMP_MARKETING_API_KEY=your_mailchimp_marketing_key_here

# Campaign "from" name and reply-to (required for send-event-announcement and welcome-email).
# MAILCHIMP_REPLY_TO must be a verified email on your Mailchimp domain.
# MAILCHIMP_FROM_NAME=Alma Links
# MAILCHIMP_REPLY_TO=noreply@almalinks.org

# Optional: custom HTML for the welcome email (sent on first signup). Use {{name}} for display name.
# If unset, a simple default welcome message is used.
# MAILCHIMP_WELCOME_TEMPLATE_HTML=<h1>Welcome!</h1><p>Hi {{name}}, thanks for joining.</p>

# ---------------------------------------------------------------------------
# Email sender (optional)
# ---------------------------------------------------------------------------
# EMAIL_FROM=Communications@almalinks.org

# ---------------------------------------------------------------------------
# Admin notifications (optional)
# ---------------------------------------------------------------------------
# ADMIN_NOTIFICATION_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# Email flows: base URL for links (production)
# ---------------------------------------------------------------------------
# Base URL for links in emails (login, events, admin pending). Used ONLY to build links; does NOT control recipients.
# In production set this so links point to your domain (e.g. https://almalinks.org). Defaults to VERCEL_URL or https://almalinks.org.
# APP_URL=https://almalinks.org

# Development-only: test recipient overrides. IGNORED when NODE_ENV=production. Do not set in production.
# TEST_EMAIL=test@example.com
# TEST_EMAIL_SIGNUP_USER, TEST_EMAIL_SIGNUP_ADMIN, etc. or SIGNUP_TEST_RECIPIENT (legacy)
