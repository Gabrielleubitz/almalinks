# Copy this file to .env and fill in your values. Do not commit .env.
# For production (e.g. Vercel), set these in the project Environment Variables.

# ---------------------------------------------------------------------------
# Mailchimp (transactional + audience)
# ---------------------------------------------------------------------------
# Mailchimp API key (format: xxxxx-us5). Used for sending transactional email
# (send-email, notify-signup, notify-user-signup, send-bulk-email).
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Mailchimp server/datacenter (e.g. us5, us6). Optional if key already has suffix.
# Used for Marketing API base URL: https://{server}.api.mailchimp.com/3.0
MAILCHIMP_SERVER=us5

# Mailchimp audience (list) ID. Required for list sync: signup → list, approval → list,
# Import users button, and adding recipients when sending bulk email.
MAILCHIMP_AUDIENCE_ID=d2650d7ca2

# Optional: Marketing API key for audience/list sync only. If not set, MAILCHIMP_API_KEY is used.
# MAILCHIMP_MARKETING_API_KEY=your_marketing_api_key_here

# ---------------------------------------------------------------------------
# Email sender (optional)
# ---------------------------------------------------------------------------
# EMAIL_FROM=Communications@almalinks.org

# ---------------------------------------------------------------------------
# Admin notifications (optional)
# ---------------------------------------------------------------------------
# ADMIN_NOTIFICATION_EMAILS=admin@example.com
