rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Default: deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // Speaker files - authenticated users can read, only owner can write
    match /speaker_files/{eventId}/{userId}/{fileName} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      // Allow write only for the file owner
      allow write: if isAuthenticated() && request.auth.uid == userId;
      // Admins can do anything
      allow read, write: if isAdmin();
    }
    
    // Profile pictures - authenticated users can read, only owner can write
    match /profile-pictures/{userId}/{fileName} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      // Allow write only for the profile owner
      allow write: if isAuthenticated() && request.auth.uid == userId;
      // Admins can do anything
      allow read, write: if isAdmin();
    }
    
    // Public assets (if any) - read only, no write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}