# Copy to .env and fill in values. Do not commit .env.
# In production (e.g. Vercel), set in Project → Settings → Environment Variables.
# Placeholders below — replace with your real values where required.

# =============================================================================
# REQUIRED — Firebase (client). Site will not load without these.
# =============================================================================
# From Firebase Console → Project Settings → General (and add app if needed).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: analytics
# VITE_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# REQUIRED — Email (transactional). At least one provider for signup/approval/rejection emails.
# =============================================================================
# Option A: Mailjet (use exact names below)
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
# Option B: Mailchimp Transactional (Mandrill) — key format: md-xxxx
# MAILCHIMP_API_KEY=

# From/sender for transactional emails (optional; defaults exist)
# EMAIL_FROM=
# TRANSACTIONAL_FROM_EMAIL=
# TRANSACTIONAL_FROM_NAME=
# TRANSACTIONAL_REPLY_TO=
# MAILCHIMP_FROM_NAME=
# MAILCHIMP_REPLY_TO=

# Base URL for links in emails (login, re-request, admin pending). Vercel sets VERCEL_URL automatically.
# APP_URL=https://your-domain.com

# Admin signup notifications — comma-separated. Required for admins to receive "new user signed up" emails.
# ADMIN_NOTIFICATION_EMAILS=admin@example.com,other@example.com

# Contact shown in rejection and support emails (optional; default: communications@almalinks.org)
# ALMA_CONTACT_EMAIL=communications@almalinks.org

# Email logos (optional). If missing, run: npm run build:email-logos. Or set full URLs.
# EMAIL_LOGO_URL=
# EMAIL_IGANI_LOGO_URL=

# =============================================================================
# REQUIRED for server/admin APIs — Firebase Admin (user management, delete user, etc.)
# =============================================================================
# One of the following:
# 1) Full JSON string (paste from Firebase Console → Service Accounts → Generate key):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# 2) Path to JSON file (local dev):
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json
# 3) Individual fields (e.g. Vercel env):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# =============================================================================
# Optional — Twilio (SMS, e.g. approval notifications)
# =============================================================================
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=

# =============================================================================
# Optional — Mailchimp Marketing (audience sync, bulk campaigns, event announcements)
# =============================================================================
# MAILCHIMP_SERVER=us5
# MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_MARKETING_API_KEY=
# MAILCHIMP_REPLY_TO=
# MAILCHIMP_FROM_NAME=
# MAILCHIMP_WELCOME_TEMPLATE_HTML=

# =============================================================================
# Optional — Cloudinary (profile and event image upload/delete)
# =============================================================================
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# =============================================================================
# Optional — HubSpot (sync contacts, integrations, email tracking)
# =============================================================================
# HUBSPOT_ACCESS_TOKEN=  (required for sync + logging sent emails to HubSpot as engagements)
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_PROPERTY_JOB_DESCRIPTION=  (optional; if set, work/jobDescription is sent to this HubSpot property)
# HUBSPOT_CONTACT_PROPERTY_PROFILE_IMAGE=  (optional; create a Contact property e.g. URL type "Profile picture URL", set its internal name here to sync user avatar)
# HubSpot → Firebase contact import: request extra properties / override list (internal names from HubSpot → Properties → Contact)
# HUBSPOT_CHAPTER_PROPERTY_NAME=chapter
# HUBSPOT_CONTACT_PROPERTY_PICTURE=picture  (comma-separated if multiple; tried first for profile image URL)
# HUBSPOT_SYNC_CONTACT_PROPERTIES_EXTRA=custom_field_one,another_field  (append to merged property list)
# HUBSPOT_SYNC_CONTACT_PROPERTIES=email,firstname,...  (optional: if set, ONLY these properties are requested from HubSpot)
# HUBSPOT_SYNC_FETCH_ALL_PROPERTIES=  (set to false to skip fetching all portal contact property names; default: fetch all)
# HUBSPOT_SYNC_MAX_PROPERTIES=100  (cap property names per HubSpot list request; default 100, max 200)
# SYNC_SECRET=
# HUBSPOT_IMPORT_DEFAULT_PASSWORD=
# Event→Deal sync: required pipeline/stage; optional custom properties (create in HubSpot first)
# HUBSPOT_DEAL_PIPELINE=default
# HUBSPOT_DEAL_STAGE=appointmentscheduled
# HUBSPOT_DEAL_PROPERTY_ALMA_EVENT_ID=alma_event_id
# HUBSPOT_DEAL_PROPERTY_LOCATION=
# HUBSPOT_DEAL_PROPERTY_DESCRIPTION=
# HUBSPOT_DEAL_PROPERTY_STATUS=
# HUBSPOT_DEAL_PROPERTY_CEO_GUEST_LIST=
# HUBSPOT_DEAL_PROPERTY_MEETING_URL=

# =============================================================================
# Optional — Overrides and scripts
# =============================================================================
# API base URL override (default: same origin)
# VITE_API_BASE_URL=
# Help page URL
# VITE_HELP_URL=
# Restore admin script: ADMIN_EMAIL=, ADMIN_PASSWORD=, FIREBASE_SERVICE_ACCOUNT_PATH=

# Development-only (ignored in production): TEST_EMAIL, TEST_MANDRILL_SECRET, TEST_MANDRILL_EMAIL, SIGNUP_TEST_RECIPIENT
