# Mailjet (transactional email) — use these exact env var names
# In Mailjet: Account → API Keys → "API Key" and "Secret Key"
MJ_APIKEY_PUBLIC=your_mailjet_api_key
MJ_APIKEY_PRIVATE=your_mailjet_secret_key
# Optional: sender (defaults to noreply@almalinks.org / "Alma Links")
# TRANSACTIONAL_FROM_EMAIL=noreply@yourdomain.com
# TRANSACTIONAL_FROM_NAME=Alma Links
# TRANSACTIONAL_REPLY_TO=support@yourdomain.com
# Email logos (Gmail often blocks SVG — use PNG)
# Option A: Add logo.png and igani-logo-placeholder.png to public/ and set APP_URL (or rely on VERCEL_URL). Emails will use https://<APP_URL>/logo.png etc.
# Option B: Set full PNG URLs here (e.g. from your CDN or main domain):
# APP_URL=https://almalinks.vercel.app
# EMAIL_LOGO_URL=https://almalinks.vercel.app/logo.png
# EMAIL_IGANI_LOGO_URL=https://almalinks.vercel.app/igani-logo-placeholder.png

# Twilio Configuration
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# OpenAI Configuration (for AI Ad Generator)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Server-side OpenAI Configuration (if using backend endpoints)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
