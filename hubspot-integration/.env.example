# HubSpot Integration Environment Variables
# Copy this file to .env.local and fill in your values

# HubSpot Portal ID (public, safe for client-side)
# Get this from your HubSpot account settings
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your-portal-id-here

# HubSpot Private App Token (server-side only, NEVER expose to client)
# Create a private app in HubSpot and generate a token
# Required scopes: crm.objects.contacts.write, crm.objects.deals.write (if using deals)
HUBSPOT_PRIVATE_APP_TOKEN=your-private-app-token-here
