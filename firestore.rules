rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to create their own profile during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow users to read/write their own profile
      allow read, update: if isOwner(userId);
      // Allow admins to read/write any user profile
      allow read, write: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Only authenticated users can read events
      allow read: if isAuthenticated();
      // Only admins can create/update/delete events
      allow write: if isAdmin();
      
      // Event registrations subcollection
      match /registrations/{userId} {
        // Users can read all registrations for events they're registered for
        allow read: if isAuthenticated();
        // Users can only create/update their own registration
        allow create, update: if isOwner(userId);
        // Admins can do anything with registrations
        allow read, write: if isAdmin();
      }
    }
    
    // Connections collection (supports both new uid1/uid2 and legacy fromUid/toUid schema)
    match /connections/{connectionId} {
      // Admins can manage any connections
      allow read, write: if isAdmin();
      
      // Users can read connections they're part of (new schema)
      allow read: if isAuthenticated() && 
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid);
      
      // Users can read connections they're part of (legacy schema)  
      allow read: if isAuthenticated() && 
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
        
      // Users can create/update connections where they are one of the participants (new schema)
      allow create, update: if isAuthenticated() && 
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
        
      // Users can create connections where they are the fromUid (legacy schema)
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
    }
    
    // Connection requests collection  
    match /connection_requests/{requestId} {
      // Helper to check if user is requester (supports both new and legacy fields)
      function isRequester() {
        return (resource.data.requesterId == request.auth.uid || resource.data.fromUid == request.auth.uid);
      }
      
      // Helper to check if user is target (supports both new and legacy fields)
      function isTarget() {
        return (resource.data.targetId == request.auth.uid || resource.data.toUid == request.auth.uid);
      }
      
      // Helper to check if user is requester in create (supports both new and legacy fields)
      function isRequesterInCreate() {
        return (request.resource.data.requesterId == request.auth.uid || request.resource.data.fromUid == request.auth.uid);
      }
      
      // Users can read requests involving them (as requester or target)
      allow read: if isAuthenticated() && (isRequester() || isTarget());
      
      // Users can create requests from themselves
      allow create: if isAuthenticated() && isRequesterInCreate();
      
      // Users can update requests sent to them (accept/reject) - supports both field names
      allow update: if isAuthenticated() && isTarget();
      
      // Admins can manage all requests
      allow write: if isAdmin();
    }
    
    // User directory collection (for global directory)
    match /user_directory/{userId} {
      // Authenticated users can read directory entries (for search)
      allow read: if isAuthenticated();
      // Users can create/update their own directory entry
      allow create, update: if isOwner(userId);
      // Admins can manage any directory entry
      allow write: if isAdmin();
    }
    
    // Announcements collection
    match /announcements/{announcementId} {
      // All authenticated users can read active announcements
      allow read: if isAuthenticated();
      // Only admins can create, update, or delete announcements
      allow write: if isAdmin();
    }
  }
}