rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Approved member: has a users doc that isn't pending/rejected (docs without status are legacy-approved,
    // matching useAuth). Applicants only have a joinRequests doc, so they can't read member data.
    function isApprovedMember() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'approved') == 'approved';
    }

    function isMember() {
      return isApprovedMember() || isAdmin();
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // --- Users ---
    // Profile docs are created by an admin (approving a join request, or creating a user); applicants never write here.
    // Read: approved members (Members directory) and the owner (PendingPage watches its own doc).
    // Update: owner, but never their own role/admin/approval/badge fields; admin anything.
    // Delete: ONLY allowed for HubSpot-imported users (importedFrom == 'hubspot'). Protects native users from HubSpot admin page or any client delete.
    match /users/{userId} {
      allow create: if isAdmin();
      allow read: if isOwner(userId) || isMember();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['role', 'admin', 'status', 'isTrustee', 'isMentor', 'importedFrom', 'approvedAt', 'approvedBy'])
      );
      allow delete: if isAdmin() && resource.data.get('importedFrom', '') == 'hubspot';
    }

    // --- Join requests (pending signups); doc id = applicant uid
    // Owner can create (signup) and update (re-request after rejection); admin can update/delete for approval/rejection
    match /joinRequests/{requestId} {
      allow read: if isOwner(requestId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if (isOwner(requestId) && request.resource.data.status == 'pending') || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Registrations (top-level; dashboard/check-in; doc id often = user uid) ---
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        registrationId == request.auth.uid
        || resource.data.get('email', '') == request.auth.token.email
      );
      allow create: if isAuthenticated()
        && registrationId == request.auth.uid
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        registrationId == request.auth.uid
        || resource.data.get('email', '') == request.auth.token.email
      );
      allow read, write: if isAdmin();
    }

    // --- Events ---
    match /events/{eventId} {
      allow read: if isMember();
      allow write: if isAdmin();
      // Members may only file (or re-file) their own registration as pending; approval and check-in are admin-only.
      match /registrations/{regId} {
        allow read: if isMember();
        allow create, update: if isOwner(regId) && isApprovedMember()
          && request.resource.data.get('status', '') == 'pending'
          && request.resource.data.get('checkedIn', false) == false;
        allow read, write: if isAdmin();
      }
      // Sensitive details (location, meeting link, zoom, pictures). Admin or approved registrant.
      match /privateDetails/{docId} {
        allow read: if isAdmin()
          || (isAuthenticated()
              && exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
              && get(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid)).data.get('status', 'approved') == 'approved');
        allow create, update, delete: if isAdmin();
      }
    }

    // --- Connections (uid1/uid2 or legacy fromUid/toUid) ---
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid
        || request.resource.data.fromUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow read, write: if isAdmin();
    }

    // --- Daily manual connection request count (limit 5/day; resets at midnight UTC) ---
    // Used only for manual requests from Members/profile. Auto post-event connections do not touch this.
    match /connection_request_daily/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Connection requests ---
    match /connection_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || resource.data.fromUid == request.auth.uid
        || resource.data.targetId == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.requesterId == request.auth.uid || request.resource.data.fromUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.targetId == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow read, write: if isAdmin();
    }

    // --- User directory ---
    match /user_directory/{userId} {
      allow read: if isMember();
      allow create, update: if isOwner(userId);
      allow read, write: if isAdmin();
    }

    // --- Announcements ---
    // Members may only update the reactions field (emoji toggles); create/delete and other updates are admin-only.
    match /announcements/{announcementId} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMember() && onlyChanges(['reactions']));
    }

    // --- Notifications (per-user; app creates for others) ---
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isMember();
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- Activity logs (client writes own; admin has full access) ---
    match /activity_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Members can read only their own activity logs; admins can read everything
      allow read, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- Chats ---
    // Chat settings and memberships are managed by admins; members only bump the last-message preview,
    // mark their own membership read, and react to / read-receipt messages.
    match /chats/{chatId} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isMember() && onlyChanges(['lastMessage', 'lastActivity']));
      allow delete: if isAdmin();
    }

    match /chat_members/{memberId} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isMember() && resource.data.userId == request.auth.uid && onlyChanges(['lastRead', 'muted'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /chat_messages/{messageId} {
      allow read: if isMember();
      // User messages: userId must be caller; system messages (userId null) allowed for admins (e.g. "X joined" from admin panel)
      allow create: if isMember() && (
        request.resource.data.userId == request.auth.uid
        || (request.resource.data.userId == null && isAdmin())
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
        || (isMember() && onlyChanges(['reactions', 'readBy', 'status']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /chat_requests/{requestId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- Chat rate limits (per-user message/join throttling; doc ids: msg_<uid>, join_<uid>) ---
    match /chat_rate_limits/{limitId} {
      allow read, write: if isAuthenticated() && (
        limitId == 'msg_' + request.auth.uid || limitId == 'join_' + request.auth.uid
      );
    }

    // --- Community memberships (event audience "group" resolution; member reads own group roster) ---
    match /communityMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // --- HubSpot contacts (server-only writes via Admin SDK) ---
    match /hubspotContacts/{contactId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Event reviews (public read on event page; create/update/delete own doc; admin full access) ---
    match /event_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // --- Default: deny any other collection ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
