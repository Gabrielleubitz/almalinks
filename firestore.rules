rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users ---
    // Profile created on signup (own uid) or when admin approves join request.
    // Read: any authenticated user (so all members can see the Members directory).
    // Update/delete: only owner or admin.
    // Delete: ONLY allowed for HubSpot-imported users (importedFrom == 'hubspot'). Protects native users from HubSpot admin page or any client delete.
    match /users/{userId} {
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow read: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin() && resource.data.get('importedFrom', '') == 'hubspot';
    }

    // --- Join requests (pending signups); doc id = applicant uid
    match /joinRequests/{requestId} {
      allow read: if isOwner(requestId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Events ---
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      match /registrations/{regId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(regId);
        allow read, write: if isAdmin();
      }
    }

    // --- Connections (uid1/uid2 or legacy fromUid/toUid) ---
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && (
        resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid
        || request.resource.data.fromUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid
        || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow read, write: if isAdmin();
    }

    // --- Daily manual connection request count (limit 5/day; resets at midnight UTC) ---
    // Used only for manual requests from Members/profile. Auto post-event connections do not touch this.
    match /connection_request_daily/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- Connection requests ---
    match /connection_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid || resource.data.fromUid == request.auth.uid
        || resource.data.targetId == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.requesterId == request.auth.uid || request.resource.data.fromUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.targetId == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow read, write: if isAdmin();
    }

    // --- User directory ---
    match /user_directory/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow read, write: if isAdmin();
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Notifications (per-user; app creates for others) ---
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- Activity logs (client writes own; only admin reads) ---
    match /activity_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, list, update, delete: if isAdmin();
    }

    // --- Chats ---
    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /chat_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /chat_messages/{messageId} {
      allow read: if isAuthenticated();
      // User messages: userId must be caller; system messages (userId null) allowed for admins (e.g. "X joined" from admin panel)
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
        || (request.resource.data.userId == null && isAdmin())
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /chat_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // --- HubSpot contacts (server-only writes via Admin SDK) ---
    match /hubspotContacts/{contactId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Default: deny any other collection ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
