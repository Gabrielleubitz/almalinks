rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to create their own profile during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow users to read/write their own profile
      allow read, update: if isOwner(userId);
      // Allow admins to read/write any user profile
      allow read, write: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Anyone can read public events
      allow read: if true;
      // Only admins can create/update/delete events
      allow write: if isAdmin();
      
      // Event registrations subcollection
      match /registrations/{userId} {
        // Users can read all registrations for events they're registered for
        allow read: if isAuthenticated();
        // Users can only create/update their own registration
        allow create, update: if isOwner(userId);
        // Admins can do anything with registrations
        allow read, write: if isAdmin();
      }
    }
    
    // TEMPORARY: More permissive connections collection for testing
    match /connections/{connectionId} {
      // Allow all authenticated users to read/write connections (TEMPORARY)
      allow read, write: if isAuthenticated();
    }
    
    // Connection requests collection  
    match /connection_requests/{requestId} {
      // Users can read requests involving them
      allow read: if isAuthenticated() && 
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Users can create requests from themselves
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      // Users can update requests sent to them (accept/reject)
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid;
      // Admins can manage all requests
      allow write: if isAdmin();
    }
    
    // User directory collection (for global directory)
    match /user_directory/{userId} {
      // Authenticated users can read directory entries (for search)
      allow read: if isAuthenticated();
      // Users can create/update their own directory entry
      allow create, update: if isOwner(userId);
      // Admins can manage any directory entry
      allow write: if isAdmin();
    }
    
    // Announcements collection
    match /announcements/{announcementId} {
      // All authenticated users can read active announcements
      allow read: if isAuthenticated();
      // Only admins can create, update, or delete announcements
      allow write: if isAdmin();
    }
  }
}